# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Discord Developer Portal -> your app -> General Information -> Public Key
DISCORD_PUBLIC_KEY=

# Used only by scripts/register_commands.py
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
# Optional: register to one guild for instant updates while developing
DISCORD_GUILD_ID=

OPENAI_API_KEY=
PINECONE_API_KEY=
